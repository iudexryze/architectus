{
  "name": "architectus",
  "displayName": "Architectus",
  "description": "Glow & animation control panel for VS Code",
  "version": "1.1.0",
  "publisher": "varun",
  "license": "MIT",
  "engines": { "vscode": "^1.70.0" },
  "categories": ["Themes", "Other"],
  "icon": "icon.png",
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "architectus-sidebar",
          "title": "Architectus",
          "icon": "./icon.svg"
        }
      ]
    },
    "views": {
      "architectus-sidebar": [
        {
          "type": "webview",
          "id": "architectus.panel",
          "name": "Architectus Console"
        }
      ]
    },
    "commands": []
  }
}
