{
  "name": "ryze-controls",
  "displayName": "Architectus",
  "description": "Glow & animation control panel for VS Code",
  "version": "1.0.0",
  "publisher": "varun",
  "license": "MIT",
  "engines": { "vscode": "^1.70.0" },
  "categories": ["Themes", "Other"],
  "icon": "icon.png",
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ryze-sidebar",
          "title": "Architectus",
          "icon": "./icon.svg"
        }
      ]
    },
    "views": {
      "ryze-sidebar": [
        {
          "type": "webview",
          "id": "ryzeControls.panel",
          "name": "Architectus Console"
        }
      ]
    },
    "commands": [
      {
        "command": "ryzeControls.enable",
        "title": "Architectus: Enable CSS"
      },
      {
        "command": "ryzeControls.disable",
        "title": "Architectus: Disable CSS"
      }
    ]
  }
}
